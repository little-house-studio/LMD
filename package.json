{
  "name": "lmd-editer",
  "publisher": "lths-local",
  "displayName": "LMD_EDITER",
  "private": true,
  "version": "0.1.0",
  "description": "Mermaid spatial editor MVP",
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [
    "onCustomEditor:lmdEditer.canvas",
    "onCommand:lmdEditer.openWithCanvas",
    "onCommand:lmdEditer.openTextSource"
  ],
  "main": "./out/extension.cjs",
  "contributes": {
    "customEditors": [
      {
        "viewType": "lmdEditer.canvas",
        "displayName": "LMD_EDITER",
        "selector": [
          {
            "filenamePattern": "*.lmd"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "lmdEditer.openWithCanvas",
        "title": "LMD_EDITER: Open Canvas View"
      },
      {
        "command": "lmdEditer.openTextSource",
        "title": "LMD_EDITER: Open Text Source"
      }
    ]
  },
  "scripts": {
    "dev": "vite",
    "dev:webview": "vite --host 127.0.0.1 --port 5280",
    "watch:extension": "tsc -p tsconfig.extension.json -w --preserveWatchOutput",
    "dev:vscode": "concurrently -k -n WEB,EXT -c cyan,magenta \"pnpm run dev:webview\" \"pnpm run watch:extension\"",
    "build:webview": "tsc -b && vite build && /opt/homebrew/bin/node ./scripts/prepare-dist-subdir.mjs",
    "build:extension": "tsc -p tsconfig.extension.json",
    "build:vscode": "pnpm run build:webview && pnpm run build:extension",
    "package:vsix": "pnpm run build:vscode && npx @vscode/vsce package --allow-missing-repository --no-dependencies --out LMD_EDITER.vsix",
    "build": "pnpm run build:webview",
    "lint": "eslint .",
    "test:lmd": "npx --yes tsx src/lmd/lmd.smoke.test.ts",
    "test:hotpath": "npx --yes tsx src/lmd/hotpath/sceneHotPath.test.ts && npx --yes tsx lmp/src/lib/layoutCache.test.ts && npx --yes tsx src/lmd/stage/stageHotPath.test.ts",
    "stress:hotpath": "npx --yes tsx scripts/perf-stress-lmd.mjs && npx --yes tsx scripts/perf-stress-lmp.mjs",
    "preview": "vite preview"
  },
  "type": "module",
  "dependencies": {
    "@mermaid-js/layout-elk": "^0.2.1",
    "@xyflow/react": "^12.11.2",
    "dagre-d3-es": "^7.0.14",
    "html-to-image": "^1.11.13",
    "mermaid": "^11.13.0",
    "pixi.js": "^8.18.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.96.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.0"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
