{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run LMD_EDITER",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.cjs"
      ],
      "preLaunchTask": "lmd-editer:dev",
      "env": {
        "LMD_EDITER_WEBVIEW_DEV_SERVER": "http://127.0.0.1:5173"
      }
    }
  ]
}
