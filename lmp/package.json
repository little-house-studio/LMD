{
  "name": "lmp-editer",
  "publisher": "lths-local",
  "displayName": "LMP_EDITER",
  "private": true,
  "version": "0.1.0",
  "description": "Little House Markmap editor",
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [
    "onCustomEditor:lmpEditer.canvas",
    "onCommand:lmpEditer.openWithCanvas",
    "onCommand:lmpEditer.openTextSource"
  ],
  "main": "./out/extension.cjs",
  "contributes": {
    "customEditors": [
      {
        "viewType": "lmpEditer.canvas",
        "displayName": "LMP_EDITER",
        "selector": [
          {
            "filenamePattern": "*.lmp"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "lmpEditer.openWithCanvas",
        "title": "LMP_EDITER: Open Canvas View"
      },
      {
        "command": "lmpEditer.openTextSource",
        "title": "LMP_EDITER: Open Text Source"
      }
    ]
  },
  "scripts": {
    "dev": "vite",
    "dev:webview": "vite --host 127.0.0.1 --port 5174",
    "watch:extension": "tsc -p tsconfig.extension.json -w --preserveWatchOutput",
    "dev:vscode": "concurrently -k -n WEB,EXT -c cyan,magenta \"pnpm run dev:webview\" \"pnpm run watch:extension\"",
    "build:webview": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:extension": "tsc -p tsconfig.extension.json",
    "build:vscode": "pnpm run build:webview && pnpm run build:extension",
    "package:vsix": "pnpm run build:vscode && npx @vscode/vsce package --allow-missing-repository --no-dependencies --out LMP_EDITER.vsix",
    "build": "pnpm run build:webview",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.96.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.0"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
